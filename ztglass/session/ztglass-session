#!/bin/sh
# What greetd starts for ztOS Glass: the ztglass compositor, with the shell
# (home screen, status bar, lock) under it. The log is kept for one run back.
[ -f /etc/ztos/session.env ] && . /etc/ztos/session.env
export ZTGLASS_SCALE=${ZTGLASS_SCALE:-${ZTMETRO_SCALE:-4}}
state=${XDG_STATE_HOME:-$HOME/.local/state}
mkdir -p "$state"
log=$state/ztglass.log
[ -f "$log" ] && mv "$log" "$log.1"
export QT_QPA_PLATFORM=wayland QT_FORCE_STDERR_LOGGING=1
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export MOZ_ENABLE_WAYLAND=1
exec /usr/local/bin/ztglass -s /usr/local/bin/ztglass-shell > "$log" 2>&1
