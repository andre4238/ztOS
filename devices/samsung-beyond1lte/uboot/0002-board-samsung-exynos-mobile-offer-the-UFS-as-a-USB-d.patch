From 8701a98057243e25ec0bd0dfc9e1037b946c4ef2 Mon Sep 17 00:00:00 2001
From: johnnyguma <Johnnyguma17@gmail.com>
Date: Sat, 14 Nov 2026 20:40:38 +0100
Subject: [PATCH 2/2] board: samsung: exynos-mobile: offer the UFS as a USB
 drive

Replaces the driver tree entry of the boot menu: the whole LUN 0 goes on the
cable (ums), so a host can take a full backup of the phone before anything
is written.
---
 board/samsung/exynos-mobile/exynos-mobile.c   | 10 +++++-----
 board/samsung/exynos-mobile/exynos-mobile.env |  8 ++++++++
 configs/exynos9820-beyond1lte_defconfig       |  1 +
 3 files changed, 14 insertions(+), 5 deletions(-)

diff --git a/board/samsung/exynos-mobile/exynos-mobile.c b/board/samsung/exynos-mobile/exynos-mobile.c
index c5d958de..daaafead 100644
--- a/board/samsung/exynos-mobile/exynos-mobile.c
+++ b/board/samsung/exynos-mobile/exynos-mobile.c
@@ -1075,7 +1075,7 @@ static const struct exynos_menu_text exynos_menu_lang[EXYNOS_LANG_COUNT] = {
 		.code = "de", .own_name = "Deutsch",
 		.entry = { "System starten", "Fastboot-Modus", "UEFI-Wartung",
 			   "Neustart", "Ausschalten", "Speicher-Diagnose",
-			   "Treiberbaum", "Download-Modus" },
+			   "USB-Massenspeicher", "Download-Modus" },
 		.language = "Sprache", .back = "Zurück",
 		.keys = "VOL+/-  bewegen   POWER  wählen",
 		.banks = "%u MB in %u Bänken",
@@ -1084,7 +1084,7 @@ static const struct exynos_menu_text exynos_menu_lang[EXYNOS_LANG_COUNT] = {
 		.code = "en", .own_name = "English",
 		.entry = { "Continue boot", "Fastboot mode", "UEFI maintenance",
 			   "Reboot", "Power off", "Storage diagnostics",
-			   "Driver tree", "Download mode" },
+			   "USB mass storage", "Download mode" },
 		.language = "Language", .back = "Back",
 		.keys = "VOL+/-  move      POWER  select",
 		.banks = "%u MB in %u banks",
@@ -1093,7 +1093,7 @@ static const struct exynos_menu_text exynos_menu_lang[EXYNOS_LANG_COUNT] = {
 		.code = "es", .own_name = "Español",
 		.entry = { "Iniciar el sistema", "Modo Fastboot",
 			   "Mantenimiento UEFI", "Reiniciar", "Apagar",
-			   "Diagnóstico de disco", "Árbol de controladores",
+			   "Diagnóstico de disco", "Almacenamiento USB",
 			   "Modo Download" },
 		.language = "Idioma", .back = "Volver",
 		.keys = "VOL+/-  mover     POWER  elegir",
@@ -1103,7 +1103,7 @@ static const struct exynos_menu_text exynos_menu_lang[EXYNOS_LANG_COUNT] = {
 		.code = "pl", .own_name = "Polski",
 		.entry = { "Uruchom system", "Tryb Fastboot", "Obsługa UEFI",
 			   "Restart", "Wyłącz", "Diagnostyka pamięci",
-			   "Drzewo sterowników", "Tryb Download" },
+			   "Pamięć masowa USB", "Tryb Download" },
 		.language = "Język", .back = "Wstecz",
 		.keys = "VOL+/-  ruch      POWER  wybierz",
 		.banks = "%u MB w %u bankach",
@@ -1127,7 +1127,7 @@ static const char * const exynos_menu_cmd[8] = {
 	"reset",
 	"poweroff",
 	"run diag_storage",
-	"run diag_dm",
+	"run umscmd",
 	"run dlmode",
 };
 
diff --git a/board/samsung/exynos-mobile/exynos-mobile.env b/board/samsung/exynos-mobile/exynos-mobile.env
index 746716bd..060ad8b9 100644
--- a/board/samsung/exynos-mobile/exynos-mobile.env
+++ b/board/samsung/exynos-mobile/exynos-mobile.env
@@ -57,6 +57,14 @@ diag_storage=echo "--- ufs init ---"; ufs init;
 	     echo "--- scsi part ---"; scsi part;
 	     echo "--- done, press a key ---"; pause; bootmenu
 
+/*
+ * The whole UFS (LUN 0: every partition Android has) as a USB drive, so a host
+ * can read a full backup before anything is written.  Ends when the cable goes
+ * or the phone is reset (Volume Down + Power).
+ */
+umscmd=run panel; echo "USB mass storage: UFS LUN 0 on the cable";
+	ums 0 scsi 0; bootmenu
+
 diag_dm=dm tree; echo "--- done, press a key ---"; pause; bootmenu
 
 button_cmd_0_name=Volume Down Key
diff --git a/configs/exynos9820-beyond1lte_defconfig b/configs/exynos9820-beyond1lte_defconfig
index 4bb7b569..dbd7dd9d 100644
--- a/configs/exynos9820-beyond1lte_defconfig
+++ b/configs/exynos9820-beyond1lte_defconfig
@@ -83,3 +83,4 @@ CONFIG_DM_REBOOT_MODE=y
 CONFIG_DM_REBOOT_MODE_SYSCON=y
 CONFIG_CMD_BCB=y
 CONFIG_FASTBOOT_OEM_BOARD=y
+CONFIG_CMD_USB_MASS_STORAGE=y
-- 
