# ztOS on the Galaxy S10: 1440x3040, 4 pixels a point like the S9.
# The Mali-G76 MP12 runs on panfrost (renderD128); the panel is still the boot
# loader's framebuffer (simpledrm, card0), which has no render node: wlroots
# renders on the GPU and copies the frame to the panel.
export ZTMETRO_SCALE=4
export WLR_RENDER_DRM_DEVICE=/dev/dri/renderD128
export WLR_NO_HARDWARE_CURSORS=1
