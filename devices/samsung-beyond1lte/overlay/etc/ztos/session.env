# ztOS on the Galaxy S10: 1440x3040, 4 pixels a point like the S9.
# No GPU driver on the mainline kernel yet (the panel runs on simpledrm), so
# OpenGL is software (llvmpipe), as in the emulator. Drop the last three lines
# once the Mali G76 (panfrost) is up.
export ZTMETRO_SCALE=4
export WLR_RENDERER_ALLOW_SOFTWARE=1
export WLR_NO_HARDWARE_CURSORS=1
export LIBGL_ALWAYS_SOFTWARE=1
