[Unit]
Description=Galaxy S10: Wi-Fi/Bluetooth firmware from the phone's vendor partition
DefaultDependencies=no
After=local-fs.target systemd-udev-settle.service
Before=NetworkManager.service
Wants=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/ztos-s10-firmware

[Install]
WantedBy=multi-user.target
