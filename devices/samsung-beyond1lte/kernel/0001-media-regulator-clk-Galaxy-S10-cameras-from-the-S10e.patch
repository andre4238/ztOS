 drivers/media/platform/samsung/Kconfig        |   1 +
 drivers/media/platform/samsung/Makefile       |   1 +
 .../platform/samsung/exynos9820-csis/Kconfig  |  14 +
 .../platform/samsung/exynos9820-csis/Makefile |   1 +
 .../samsung/exynos9820-csis/exynos9820-csis.c | 976 ++++++++++++++++++
 drivers/regulator/Kconfig                     |  16 +
 drivers/regulator/Makefile                    |   2 +
 drivers/regulator/s2mpb02-regulator.c         | 172 +++
 drivers/regulator/s2mpb03-regulator.c         | 123 +++
 .../dt-bindings/clock/samsung,exynos9820.h    |  23 +
 18 files changed, 3488 insertions(+)
 create mode 100644 drivers/media/i2c/s5k2l4-tables.h
