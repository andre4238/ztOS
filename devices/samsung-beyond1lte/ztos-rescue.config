# ztOS rescue fragment for the Galaxy S10 (on top of arm64 defconfig +
# S10Plus_Linux exynos9820.config + bringup.config).
# Everything the initramfs needs is built in: no modules on the first boot.
CONFIG_LOCALVERSION="-ztos-s10"
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_PRINTK_TIME=y
CONFIG_MAGIC_SYSRQ=y
# USB gadget over the cable: serial console (ACM) + network (NCM, macOS has a driver)
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_EXYNOS=y
CONFIG_PHY_EXYNOS5_USBDRD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFS_EXYNOS=y
CONFIG_EXT4_FS=y
